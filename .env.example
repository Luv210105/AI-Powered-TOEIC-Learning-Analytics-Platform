# .env.example — MẪU khai báo biến môi trường cho Phase 1 (MinIO + PostgreSQL).
#
# CÁCH DÙNG:
#   1. Copy file này thành .env:   cp .env.example .env
#   2. Sửa các giá trị bên dưới thành giá trị THẬT của bạn.
#   3. KHÔNG commit file .env (đã nằm trong .gitignore) — chỉ commit .env.example.
#
# Lưu ý: đây chỉ là giá trị mẫu/placeholder — ĐỔI mật khẩu trước khi dùng thật.

# ---------------------------------------------------------------------------
# MinIO — tài khoản admin (root) để đăng nhập console và tạo bucket.
# MINIO_ROOT_PASSWORD phải dài tối thiểu 8 ký tự (yêu cầu của MinIO).
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_123

# ---------------------------------------------------------------------------
# PostgreSQL — tài khoản + database khởi tạo khi container chạy lần đầu.
# ---------------------------------------------------------------------------
POSTGRES_USER=toeic
POSTGRES_PASSWORD=changeme_pg_123
POSTGRES_DB=toeic
